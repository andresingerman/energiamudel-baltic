{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://energiamudel.ee/schema/manifest.schema.json",
  "title": "Manifest",
  "description": "The export's index (SPECIFICATION R-DATA-8, R-PROV-1): every file with its SHA-256 and size, and for every series in it the lineage ids it derives from; the hash of the export code and contract, and of the export as a whole.",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract", "code", "export", "files"],
  "properties": {
    "contract": {"const": 1},
    "code": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "export": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "files": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["sha256", "bytes", "series"],
        "properties": {
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "bytes": {"type": "integer", "minimum": 1},
          "series": {"type": "object", "additionalProperties": {"type": "array", "minItems": 1, "items": {"type": "string"}}}
        }
      }
    }
  }
}
