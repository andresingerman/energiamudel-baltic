{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://energiamudel.ee/schema/links.schema.json",
  "title": "Links",
  "description": "Scenario transfer capacities (SPECIFICATION R-LINK-1, R-LINK-3): the documentary capacities per scenario source, kind, border, direction and year, and ERAA 2025's hourly NTC per border, direction and target year (8 760 hours).",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract", "table", "eraa2025_hourly"],
  "properties": {
    "contract": {"const": 1},
    "table": {
      "type": "object",
      "additionalProperties": {"type": "object", "additionalProperties": {"type": "object", "additionalProperties": {"type": "object", "additionalProperties": {"type": "object", "additionalProperties": {
        "type": "object", "additionalProperties": false, "required": ["mw", "src"],
        "properties": {"mw": {"type": "number"}, "src": {"type": "array", "items": {"type": "string"}}}}}}}}
    },
    "eraa2025_hourly": {
      "type": "object",
      "additionalProperties": {"type": "object", "additionalProperties": {"type": "object", "additionalProperties": {"type": "array", "minItems": 8760, "maxItems": 8760, "items": {"type": "number", "minimum": 0}}}}
    }
  }
}
