# Copy to .env and fill in. .env is git-ignored; never commit tokens (AGENTS.md §2, R-NFR-10).

# ENTSO-E Transparency Platform REST API. Request a token by e-mail as described at
# https://transparency.entsoe.eu/ (Account settings -> Web API).
ENTSOE_TOKEN=

# Fingrid Open Data (https://data.fingrid.fi), free after registration.
FINGRID_API_KEY=

# Optional: where the DuckDB file lives. Default: data/energiamudel.duckdb
# ENERGIAMUDEL_DB=

# Optional: raw cache and lineage roots. Defaults: data/raw, data/lineage
# ENERGIAMUDEL_RAW=
# ENERGIAMUDEL_LINEAGE=

# Optional: open the database read-only (for readers beside a running build).
# ENERGIAMUDEL_READ_ONLY=1

# JAO, Nord Pool UMM, the Baltic Transparency Dashboard, Open-Meteo, EEX, the World Bank,
# TYNDP and ERAA need no credential.
