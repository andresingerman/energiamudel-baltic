# Secrets (R-NFR-10)
.env

# Raw API responses and their lineage records: large, refetchable with `make history` (R-DATA-9)
data/raw/*
!data/raw/.gitkeep
data/lineage/*
!data/lineage/.gitkeep

# The owner's reference material (Elering and TalTech's consultation files, the workshop's transcript
# and slides): read by no code, not in the raw cache, never committed (D-036)
data/owner/

# The database is a build artefact, rebuilt from data/raw + data/lineage by `make db` (R-DATA-5)
data/*.duckdb
data/*.duckdb.wal

# Python
__pycache__/
*.py[cod]
.venv/
*.egg-info/
build/
.pytest_cache/
.ruff_cache/

# Node (app/, from Stage 4)
node_modules/
app/dist/

# Editors and OS
.DS_Store
.idea/
.vscode/
*.swp
# the test weeks gap_weeks.ts writes for the LP (regenerated by make gap)
data/derived/gap/weeks/
# the Kruonis spike's own fetch of BTD activations (refetched by `kruonis.py fetch`)
spikes/kruonis-balancing/cache/

# Local preview configuration of the coding agent
.claude/launch.json

# the Finnish zone model's inputs, made by spikes/finland/prep.py
data/derived/finland/
data/derived/neighbours2035/
data/derived/curves/
data/derived/presentation/

# the freeze's set-aside raw files (make freeze) and the offline copy of the site (make offline)
data/raw-aside/
data/derived/offline/

# the owner's prepared answers to likely questions of the talk: kept on the owner's machine, never committed (D-323)
spikes/presentation-2026-11/kusimused_ja_vastused.md

# the owner's working files, kept on the owner's machine and never committed (D-327): one-pagers and reviews, notes,
# earlier versions of research memos, a design tool's settings, a scratch test of the page's workers, solver timings
reports/
research_notes/
docs/research/*.pdf
.impeccable/
app/stress.html
app/stress.ts
data/derived/solver-speed/
