<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- D-108: Nord Pool's aggregated bid curves, twice a day. `make nordpool-schedule` fills in
     @HOME@ and installs it; to stop: launchctl bootout gui/$(id -u)/ee.energiamudel.nordpool -->
<plist version="1.0">
<dict>
  <key>Label</key><string>ee.energiamudel.nordpool</string>
  <key>ProgramArguments</key>
  <array>
    <string>/usr/bin/python3</string>
    <string>@HOME@/Library/Application Support/energiamudel/nordpool_fetch.py</string>
  </array>
  <key>StartCalendarInterval</key>
  <array>
    <dict><key>Hour</key><integer>15</integer><key>Minute</key><integer>0</integer></dict>
    <dict><key>Hour</key><integer>23</integer><key>Minute</key><integer>30</integer></dict>
  </array>
  <key>StandardOutPath</key><string>@HOME@/Library/Logs/energiamudel-nordpool.log</string>
  <key>StandardErrorPath</key><string>@HOME@/Library/Logs/energiamudel-nordpool.log</string>
</dict>
</plist>
